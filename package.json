{
  "name": "@bou-co/parsing",
  "version": "3.0.0-rc.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "pretty": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p src/templates/tsconfig.json --noEmit",
    "build": "npm run test && npm run typecheck && vite build",
    "publish:dev": "npm run build && npm publish --tag dev",
    "publish:v3-rc": "npm run build && npm publish --tag v3-rc",
    "publish:latest": "npm run build && npm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bou-co/parsing.git"
  },
  "bugs": {
    "url": "https://github.com/bou-co/parsing/issues"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@typescript-eslint/utils": "^8.46.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "bin": {
    "bou-parsing": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "default": "./dist/types.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs",
      "default": "./dist/react/index.js"
    },
    "./templates/*": {
      "types": "./dist/templates/*.d.ts",
      "import": "./dist/templates/*.js",
      "require": "./dist/templates/*.cjs",
      "default": "./dist/templates/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
